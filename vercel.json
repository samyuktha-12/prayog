{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "frontend/dist/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py/health" },
    { "source": "/warmup", "destination": "/api/index.py/warmup" },
    { "source": "/experiments/:path*", "destination": "/api/index.py/experiments/:path*" },
    { "source": "/session/:path*", "destination": "/api/index.py/session/:path*" },
    { "source": "/respond", "destination": "/api/index.py/respond" }
  ]
}
